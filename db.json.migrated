                                  "id": "81aa8a86-2452-4c1a-a217-1bcbab78a52b",
                                  "ideaId": "d94f4e8e-4578-4d26-9140-bc058ca23814",
                                  "timestamp": "2026-09-24T20:01:29.179Z",
