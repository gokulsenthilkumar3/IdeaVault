                                    "priority": "medium",
                                    "tagIds": [],
                                    "pinned": false,
                                    "position": 4,
                                    "createdAt": "2026-09-24T20:05:58.465Z",
                                    "updatedAt": "2026-09-24T20:05:58.465Z",
